import numpy as np

# ① 创建数组
a = np.array([1, 2, 3, 4])
b = np.zeros((2, 3))        # 2行3列全0
c = np.arange(0, 10, 2)     # [0, 2, 4, 6, 8]
d = np.linspace(0, 1, 5)    # 0到1之间等分5个点
print(a)
print(b)
print(c)
print(d)

# ② 形状
arr = np.arange(12).reshape(3, 4)   # 变形成3行4列
print(arr)
print(arr.shape, arr.ndim, arr.dtype, arr.size)

# ③ 索引切片
print(arr[0, 1])      # 第0行第1列
print(arr[:, 1])      # 第1列全部（冒号=取所有行）
print(arr[1:3, 1:3])  # 切子块

# ④ 广播
x = np.array([[1, 2, 3], [4, 5, 6]])
print(x + 10)   # 每个元素都+10
print(x * 2)    # 每个元素都×2